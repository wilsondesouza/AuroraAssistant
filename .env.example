# ==============================================================================
# AURORA VOICE ASSISTANT - CONFIGURAÇÕES DE AMBIENTE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROVEDOR DE LLM (PLUGGÁVEL E FÁCIL DE TROCAR)
# Opções: "openrouter", "groq", "gemini", "cerebras", "ollama", "custom"
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_API_KEY=SuaChaveLLM

# Chaves específicas de provedores (permite alternar trocando apenas LLM_PROVIDER)
OPENROUTER_KEY=SuaChaveOpenRouter
GROQ_API_KEY=SuaChaveGroq
GEMINI_API_KEY=SuaChaveGemini
CEREBRAS_API_KEY=SuaChaveCerebras

# Caso use Ollama local (ex: rodando em outro PC na mesma rede) ou endpoint personalizado:
OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions
# LLM_BASE_URL=https://meu-endpoint-personalizado.com/v1/chat/completions

# Modelos (OpenRouter) (caso altere LLM_PROVIDER=openrouter):
# MODEL_CONVERSA=meta-llama/llama-3.3-70b-instruct:free
# MODEL_CLASSIFICADOR=meta-llama/llama-3.2-3b-instruct:free
# MODEL_HA=google/gemma-3-12b-it:free

# Modelos recomendados para Groq (caso altere LLM_PROVIDER=groq):
# MODEL_CONVERSA=openai/gpt-oss-120b
# MODEL_CLASSIFICADOR=openai/gpt-oss-20b
# MODEL_HA=qwen/qwen3.8-27b

# Modelos recomendados para Gemini (caso altere LLM_PROVIDER=gemini):
# MODEL_CONVERSA=gemini-2.0-flash
# MODEL_CLASSIFICADOR=gemini-1.5-flash
# MODEL_HA=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 2. HOME ASSISTANT
# Opções: http://192.168.35.70:8123
# ------------------------------------------------------------------------------
HA_URL=http://ha.home
HA_TOKEN=SeuTokenHomeAssistant
HA_TIMEOUT=8

# ------------------------------------------------------------------------------
# 3. NAVIDROME (STREAMING DE MÚSICA LOCAL)
# Opções: http://192.168.35.70:4533
# ------------------------------------------------------------------------------
NAVIDROME_API_URL=http://music.home
NAVIDROME_USER=user
NAVIDROME_PASSWORD=password
NAVIDROME_TIMEOUT=10

# ------------------------------------------------------------------------------
# 4. SÍNTESE DE VOZ PLUGGÁVEL (TTS MULTI-PROVEDOR + FALLBACK AUTOMÁTICO)
# Opções de TTS_PROVIDER: "google" (Chirp3-HD), "elevenlabs", "openrouter"
# Cadeia de fallback opcional (separada por vírgula) caso o primário falhe:
# ------------------------------------------------------------------------------
TTS_PROVIDER=google
TTS_FALLBACK_PROVIDERS=elevenlabs,openrouter
TTS_TIMEOUT=15

# Estilo conversacional e prosódico gerado pela LLM para o TTS:
# "expressive_rj" (ritmo natural carioca, pausas com travessão, atuação e perguntas) ou "neutral"
AURORA_SPEECH_STYLE=expressive_rj

# --- 4.a) Google Cloud TTS (pt-BR-Chirp3-HD) ---
GOOGLE_APPLICATION_CREDENTIALS=config/gTTS/arquivo.json
TTS_VOICE_NAME=pt-BR-Chirp3-HD-Erinome
TTS_LANGUAGE_CODE=pt-BR

# --- 4.b) ElevenLabs TTS ---
# Modelos recomendados:
#   - eleven_multilingual_v2 (máxima expressividade dramática e atuação em pt-BR)
#   - eleven_flash_v2_5      (latência ultra-baixa ~75ms para respostas instantâneas)
ELEVENLABS_API_KEY=SuaChaveElevenLabs
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Dica de prosódia: stability menor (0.35-0.45) e style moderado (0.35-0.50) deixam a fala mais humana e atuada
ELEVENLABS_STABILITY=0.38
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.40
ELEVENLABS_SPEAKER_BOOST=true

# --- 4.c) OpenRouter TTS (/api/v1/audio/speech) ---
# Se OPENROUTER_TTS_API_KEY ficar vazio, reaproveita automaticamente OPENROUTER_KEY
# OPENROUTER_TTS_API_KEY=SuaChaveOpenRouter
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
OPENROUTER_TTS_VOICE=coral
OPENROUTER_TTS_SPEED=1.0
# OPENROUTER_TTS_INSTRUCTIONS="Fale em português brasileiro natural do Rio de Janeiro, com sotaque carioca leve, caloroso e espontâneo..."

# --- 4.d) Controle de Volume Temporário durante a Fala (ALSA) ---
TTS_VOLUME_LEVEL=100
TTS_VOLUME_CONTROL=Master

# ------------------------------------------------------------------------------
# 4.1 RECONHECIMENTO DA SAÍDA DE ÁUDIO (ALSA)
# ------------------------------------------------------------------------------
AUDIO_OUTPUT_DRIVER=alsa
AUDIO_OUTPUT_DEVICE=hw:0,0

# ------------------------------------------------------------------------------
# 5. PREVISÃO DO TEMPO (OPENWEATHER)
# ------------------------------------------------------------------------------
OPENWEATHER_KEY=SuaChaveOpenWeather
OPENWEATHER_CITY=SuaCidade
OPENWEATHER_TIMEOUT=8

# ------------------------------------------------------------------------------
# 6. RECONHECIMENTO DE VOZ & CONVERSA CONTÍNUA (FOLLOW-UP SEM WAKE WORD)
# ------------------------------------------------------------------------------
WAKE_WORD=aurora
# Quando true, se a Aurora terminar a fala com pergunta ('?'), emite o bip e escuta a resposta automaticamente
CONTINUOUS_CONVERSATION=true
CONTINUOUS_MAX_TURNS=3
CONTINUOUS_LISTEN_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 7. MEMÓRIA DE CONTEXTO, MINI-RAG EM SQLITE, TOOLS & STREAMING TTS
# (Otimizados para Orange Pi 3 LTS e 100% Free-Tier)
# ------------------------------------------------------------------------------
# Janela deslizante curta em RAM (últimos N pares de fala + expiração em segundos)
CONVERSATION_HISTORY_TURNS=3
CONVERSATION_TTL_SECONDS=180

# Memória permanente da casa/família em SQLite nativo + Embeddings gratuitos Gemini (opcional)
MEMORY_DB_PATH=config/memory/aurora_memory.db
MEMORY_TOP_K=3
# Se true e GEMINI_API_KEY estiver preenchida, usa gemini-embedding-001; caso contrário usa SQLite FTS5 offline
MEMORY_USE_EMBEDDINGS=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Structured Output JSON (no Home Assistant), Tool Calling seletivo (máx 2 passos) e Streaming por Frase no TTS
LLM_USE_JSON_MODE=true
LLM_ENABLE_TOOLS=true
LLM_TOOL_MAX_STEPS=2
LLM_STREAM_TTS=true
LLM_STREAM_MIN_CHARS=55

# ------------------------------------------------------------------------------
# 8. BUSCA NA WEB EM TEMPO REAL / WEB GROUNDING PLUGGÁVEL (PLACARES, NOTÍCIAS, DÓLAR)
# Opções de WEB_SEARCH_PROVIDER: "auto", "serper" (Google BR), "tavily", "free" (zero chave!)
# No modo "auto", usa Serper/Tavily se tiver chave preenchida e cai para "free" automaticamente
# ------------------------------------------------------------------------------
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_FALLBACK_PROVIDERS=serper,tavily,free
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_TIMEOUT=8

# Chaves opcionais (se deixar em branco ou 'SuaChave...', o modo 'free' já funciona sem cadastro!):
# Serper.dev -> 2.500 buscas reais no Google Brasil grátis (ótimo para placares esportivos)
SERPER_API_KEY=SuaChaveSerper
# Tavily.com -> 1.000 buscas/mês grátis renováveis sem cartão de crédito
TAVILY_API_KEY=SuaChaveTavily