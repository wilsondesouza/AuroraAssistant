# ==============================================================================
# .gitignore para a AuroraAssistant
# ==============================================================================

# --- Segredos -----------------------------------------------------------------
.env
.env.*
!.env.example
*.env
secrets/
config/*.json
config/**/keys.env
config/**/gtts-file.json
config/**/gtts-example.json
service-account*.json
*.pem
*.key
*.txt
*.md
*.ps1

# --- Dados gerados em runtime -------------------------------------------------
config/memory/
config/music/*.json
config/music/*.txt
logs/
media/

# --- Artefatos -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
scripts/

# --- Sistema / IDE -------------------------------------------------------------
.DS_Store
.vscode/
.idea/

# --- Versionamento Explícito ---------------------------------------------------
!requirements.txt
!README.md
!refatored/tests/